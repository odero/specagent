# =============================================================
# SpecAgent — Autonomous Development Agent
# Copy this file to .env and fill in your values.
# =============================================================

# --- LLM Provider: choose ONE block ---

# Option A: GitHub Models (GitHub Copilot — recommended for local use)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_MODEL=gpt-4o

# Option B: Azure OpenAI
# AZURE_OPENAI_API_KEY=your_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Option C: Standard OpenAI
# OPENAI_API_KEY=sk-your_key

# --- Agent behaviour ---
HITM_MODE=true                  # true = human-in-the-loop checkpoints, false = fully autonomous
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# --- Dashboard ---
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000
DEBUG=false

# --- Output ---
OUTPUT_DIR=./output
SPECS_DIR=./specs
